# Login (required)
APP_USERNAME=me
APP_PASSWORD=change-this-to-a-long-password
# Random secret for signing session cookies, e.g. `openssl rand -base64 32`
AUTH_SECRET=

# Upstash Redis. Vercel sets these automatically when you connect Upstash from the Storage tab.
# Leave empty locally to use a temporary in-memory store.
KV_REST_API_URL=
KV_REST_API_TOKEN=
